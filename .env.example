# Copy to .env to override. Every value here is also the built-in default,
# so the app runs with no .env at all.

# Where Ollama is listening.
OLLAMA_URL=http://127.0.0.1:11434

# Open-weight model used as the conversation core.
# Alternatives already available locally: qwen3.5:4b, deepseek-r1:8b
OLLAMA_MODEL=gemma3:4b

# Express proxy port (Vite dev server forwards /api here).
PORT=3001